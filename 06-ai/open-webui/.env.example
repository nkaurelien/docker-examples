# Open WebUI environment variables configuration

# URL pointing to Ollama API.
#
# Option A: Using the container-based SSH tunnel (Ollama running inside ollama-tunnel namespace)
OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Option B: Using a host-based SSH tunnel (running SSH tunnel directly on your Mac/host machine)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Option C: Direct network connection to remote Ollama (if port 11434 is publicly exposed)
# OLLAMA_BASE_URL=http://your-remote-ollama-ip:11434

# Enable/disable authentication (False enables single-user mode without login)
WEBUI_AUTH=False

# SSH Tunnel Configuration (Used by root Makefile and docker compose container tunnel)
# OLLAMA_SSH_HOST=your-remote-server-ip
# OLLAMA_SSH_PORT=22
# OLLAMA_SSH_USER=username
# OLLAMA_SSH_PASSWORD=your-password
