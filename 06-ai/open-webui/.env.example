# Open WebUI environment variables configuration

# URL pointing to Ollama API.
# If Ollama is running on the remote host and you are forwarding port 11434 via SSH:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# If Ollama is directly reachable on the remote host:
OLLAMA_BASE_URL=http://your-remote-ollama-ip:11434

# Enable/disable authentication (False enables single-user mode without login)
WEBUI_AUTH=False

# SSH Tunnel Configuration (Used by root Makefile and docker compose container tunnel)
# OLLAMA_SSH_HOST=your-remote-server-ip
# OLLAMA_SSH_PORT=22
# OLLAMA_SSH_USER=username
# OLLAMA_SSH_PASSWORD=your-password
