# Dozzle Notification Dispatchers & Alert Subscriptions Configuration
# Generated by Ansible — do not edit manually

subscriptions: []
dispatchers:
{% if dozzle_ntfy_enabled | default(true) %}
  - id: 1
    name: ntfy
    type: webhook
    url: "{{ dozzle_ntfy_url }}"
    template: |-
      {
        "topic": "dozzle-{{ '{{' }} .Container.HostName {{ '}}' }}",
        "title": "{{ '{{' }} .Container.Name {{ '}}' }}",
        "message": "{{ '{{' }} .Detail {{ '}}' }}"
      }
{% endif %}
