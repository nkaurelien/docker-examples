# Dozzle Real-time Docker Log Viewer Stack
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/dozzle.svg
  urls:
    - https://dozzle.dev/
    - https://github.com/amir20/dozzle

services:
  dozzle-init:
    image: busybox:latest
    container_name: dozzle-init
    volumes:
      - {{ dozzle_data_dir }}:/data
    command:
      - sh
      - -c
      - |
        mkdir -p /data
        if [ ! -f /data/notifications.yml ]; then
          printf 'subscriptions: []\ndispatchers:\n  - id: 1\n    name: ntfy\n    type: webhook\n    url: {{ dozzle_ntfy_url }}\n    template: |-\n      {\n        "topic": "{{ dozzle_ntfy_topic }}",\n        "title": "{{ '{{' }} .Container.Name {{ '}}' }}",\n        "message": "{{ '{{' }} .Detail {{ '}}' }}"\n      }\n' > /data/notifications.yml
        fi
        chmod -R 777 /data
    restart: "no"

  dozzle:
    image: {{ dozzle_image }}
    container_name: dozzle
    restart: unless-stopped
    depends_on:
      dozzle-init:
        condition: service_completed_successfully
    environment:
      DOZZLE_ENABLE_MCP: "{{ dozzle_enable_mcp | default(true) | lower }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ dozzle_data_dir }}:/data
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/dozzle.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.dozzle.rule=Host(`{{ dozzle_hostname }}`)"
      - "traefik.http.routers.dozzle.entrypoints=websecure"
      - "traefik.http.routers.dozzle.tls.certresolver=letsencrypt"
      - "traefik.http.routers.dozzle.middlewares=crowdsec-bouncer@file,tinyauth-auth@docker"
      - "traefik.http.services.dozzle.loadbalancer.server.port=8080"
    healthcheck:
      test: ["CMD", "/dozzle", "healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
        reservations:
          memory: 32M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
