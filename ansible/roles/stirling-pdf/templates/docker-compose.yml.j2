# Stirling-PDF — Full-Featured Server-Side PDF Suite Stack
# Generated by Ansible — do not edit manually

services:
  stirling-pdf:
    image: {{ stirling_pdf_image }}
    container_name: stirling-pdf
    restart: unless-stopped
    environment:
      - DOCKER_ENABLE_SECURITY=false
      - SECURITY_ENABLE_LOGIN=false
      - SECURITY_ENABLELOGIN=false
      - UI_APPNAME=Stirling-PDF
      - LANGS=fr_FR,en_US
      - JAVA_TOOL_OPTIONS=-XX:MaxMetaspaceSize=384m -XX:MaxRAMPercentage=65
    volumes:
      - ./trainingData:/usr/share/tessdata
      - ./configs:/configs
      - ./logs:/logs
      - ./customFiles:/customFiles
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.stirling-pdf.rule=Host(`{{ stirling_pdf_hostname }}`) || Host(`{{ stirling_pdf_alias_hostname }}`) || Host(`{{ stirling_pdf_short_alias_hostname }}`)"
      - "traefik.http.routers.stirling-pdf.entrypoints=websecure"
      - "traefik.http.routers.stirling-pdf.tls.certresolver=letsencrypt"
      - "traefik.http.routers.stirling-pdf.middlewares=crowdsec-bouncer@file,tinyauth-auth@docker"
      - "traefik.http.services.stirling-pdf.loadbalancer.server.port={{ stirling_pdf_container_port }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:{{ stirling_pdf_container_port }}/ | grep -qE '^(200|302|401)' || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 5
      start_period: 45s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 1280M
        reservations:
          cpus: "0.10"
          memory: 256M


networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
