# Umami Web Analytics Stack
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/umami.svg
  urls:
    - https://umami.is/
    - https://github.com/umami-software/umami

services:
  umami:
    image: {{ umami_image }}
    container_name: umami
    restart: unless-stopped
    depends_on:
      umami-db:
        condition: service_healthy
    environment:
      - DATABASE_URL=postgresql://{{ umami_db_user }}:{{ umami_db_password }}@umami-db:5432/{{ umami_db_name }}
      - APP_SECRET={{ umami_app_secret }}
      - PORT={{ umami_container_port }}
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - umami-internal
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/umami.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.umami.rule=Host(`{{ umami_hostname }}`) || Host(`{{ umami_alias_hostname }}`)"
      - "traefik.http.routers.umami.entrypoints=websecure"
      - "traefik.http.routers.umami.tls.certresolver=letsencrypt"
      - "traefik.http.routers.umami.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.umami.loadbalancer.server.port={{ umami_container_port }}"
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://127.0.0.1:{{ umami_container_port }}/api/heartbeat || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M
        reservations:
          cpus: "0.10"
          memory: 128M

  umami-db:
    image: postgres:16-alpine
    container_name: umami-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ umami_db_name }}
      - POSTGRES_USER={{ umami_db_user }}
      - POSTGRES_PASSWORD={{ umami_db_password }}
    volumes:
      - umami-db-data:/var/lib/postgresql/data
    networks:
      - umami-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ umami_db_user }} -d {{ umami_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M
        reservations:
          cpus: "0.10"
          memory: 128M

volumes:
  umami-db-data:

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
  umami-internal:
    driver: bridge
