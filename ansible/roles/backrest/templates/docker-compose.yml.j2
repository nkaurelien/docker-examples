# Backrest — Web UI & Orchestrator for Restic Backup
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/restic.svg
  urls:
    - https://github.com/garethgeorge/backrest

services:
  backrest:
    image: {{ backrest_image }}
    container_name: backrest
    hostname: backrest
    restart: unless-stopped
    environment:
      - BACKREST_PORT={{ backrest_port }}
      - BACKREST_CONFIG=/config/config.json
      - BACKREST_DATA=/data
      - TZ=Europe/Paris
    volumes:
      - backrest-config:/config
      - backrest-cache:/cache
      - /var/lib/docker/volumes:/userdata/volumes:ro
      - /opt:/userdata/opt:ro
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - default
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/restic.svg"
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_public_network | default('traefik-public') }}"
      - "traefik.http.routers.backrest.rule=Host(`{{ backrest_hostname }}`)"
      - "traefik.http.routers.backrest.entrypoints=websecure"
      - "traefik.http.routers.backrest.tls.certresolver=letsencrypt"
      - "traefik.http.routers.backrest.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.backrest.loadbalancer.server.port={{ backrest_port }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ backrest_port }}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512M
        reservations:
          memory: 128M

volumes:
  backrest-config:
  backrest-cache:

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
