# TinyAuth SSO Authentication Stack
# Generated by Ansible — do not edit manually

services:
  tinyauth:
    image: {{ tinyauth_image }}
    container_name: tinyauth
    restart: unless-stopped
    environment:
      - SECRET={{ tinyauth_secret }}
      - USERS={{ tinyauth_users_string }}
      - APP_URL=https://{{ tinyauth_hostname }}
      - COOKIE_SECURE=true
      - COOKIE_DOMAIN={{ traefik_domain | default('kamitbrains.fr') }}
      - RESOURCES_DIR=/data/resources
      - TINYAUTH_RESOURCES_DIR=/data/resources
      - BACKGROUND_IMAGE=/background.jpg
      - TINYAUTH_BACKGROUND_IMAGE=/background.jpg
      - TINYAUTH_UI_BACKGROUNDIMAGE=/background.jpg
      - TINYAUTH_UI_TITLE=KamitBrains Auth

    volumes:
      - ./background.jpg:/data/resources/background.jpg:ro
      - ./background.jpg:/resources/background.jpg:ro
      - ./background.jpg:/background.jpg:ro


    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.tinyauth.rule=Host(`{{ tinyauth_hostname }}`)"
      - "traefik.http.routers.tinyauth.entrypoints=websecure"
      - "traefik.http.routers.tinyauth.tls.certresolver=letsencrypt"
      - "traefik.http.routers.tinyauth.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.tinyauth.loadbalancer.server.port=3000"
      # Export TinyAuth ForwardAuth middleware for Traefik routers
      - "traefik.http.middlewares.tinyauth-auth.forwardauth.address=http://tinyauth:3000/api/auth/traefik"
      - "traefik.http.middlewares.tinyauth-auth.forwardauth.trustForwardHeader=true"
      - "traefik.http.middlewares.tinyauth-auth.forwardauth.authResponseHeaders=X-Auth-User"
    healthcheck:
      test: ["CMD", "./tinyauth", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 64M
        reservations:
          memory: 16M


networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
