# Gotify — Self-Hosted Real-Time Push Notification Server
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/gotify.svg
  urls:
    - https://gotify.net/
    - https://github.com/gotify/server

services:
  gotify:
    image: {{ gotify_image }}
    container_name: gotify
    restart: unless-stopped
    environment:
      - GOTIFY_DEFAULTUSER_NAME={{ gotify_admin_user }}
      - GOTIFY_DEFAULTUSER_PASS={{ gotify_admin_password }}
      - GOTIFY_SERVER_PORT=80
      - GOTIFY_SERVER_KEEPCONTAINERPASS=false
      - TZ=Europe/Paris
    volumes:
      - gotify-data:/app/data
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/gotify.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.gotify.rule=Host(`{{ gotify_hostname }}`) || Host(`{{ gotify_alias_hostname }}`)"
      - "traefik.http.routers.gotify.entrypoints=websecure"
      - "traefik.http.routers.gotify.tls.certresolver=letsencrypt"
      - "traefik.http.routers.gotify.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.gotify.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:80/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          memory: 32M

volumes:
  gotify-data:

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
