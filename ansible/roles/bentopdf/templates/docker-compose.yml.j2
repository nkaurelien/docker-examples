# BentoPDF — Privacy-First Client-Side PDF Toolkit Stack
# Generated by Ansible — do not edit manually

services:
  bentopdf:
    image: {{ bentopdf_image }}
    container_name: bentopdf
    restart: unless-stopped
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.bentopdf.rule=Host(`{{ bentopdf_hostname }}`) || Host(`{{ bentopdf_alias_hostname }}`)"
      - "traefik.http.routers.bentopdf.entrypoints=websecure"
      - "traefik.http.routers.bentopdf.tls.certresolver=letsencrypt"
      - "traefik.http.routers.bentopdf.middlewares=crowdsec-bouncer@file,tinyauth-auth@docker"
      - "traefik.http.services.bentopdf.loadbalancer.server.port={{ bentopdf_container_port }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:{{ bentopdf_container_port }}/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          cpus: "0.05"
          memory: 64M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
