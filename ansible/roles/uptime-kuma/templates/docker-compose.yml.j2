# Uptime Kuma Status & Uptime Monitoring Stack
# Generated by Ansible — do not edit manually

services:
  uptime-kuma:
    image: {{ uptime_kuma_image }}
    container_name: uptime-kuma
    restart: unless-stopped
    ports:
      - "{{ uptime_kuma_port }}:3001"
    volumes:
      - uptime-kuma-data:/app/data
    environment:
      - TZ={{ uptime_kuma_timezone }}
      - UMASK=0022
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.uptime-kuma.rule=Host(`{{ uptime_kuma_hostname }}`)"
      - "traefik.http.routers.uptime-kuma.entrypoints=websecure"
      - "traefik.http.routers.uptime-kuma.tls.certresolver=letsencrypt"
      - "traefik.http.routers.uptime-kuma.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.uptime-kuma.loadbalancer.server.port=3001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 512M
        reservations:
          cpus: "0.10"
          memory: 128M

  uptime-kuma-db-seeder:
    image: alpine:latest
    container_name: uptime-kuma-db-seeder
    volumes:
      - uptime-kuma-data:/app/data
    entrypoint:
      - sh
      - -c
      - |
        echo "Waiting for Uptime Kuma database..."
        until [ -f /app/data/kuma.db ]; do sleep 1; done
        apk add --no-cache -q sqlite
        
        # Seed core infrastructure monitors
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, url, type, method, interval, description) VALUES (1, 'Traefik Proxy', 1, 'https://traefik.{{ traefik_domain | default('kamitbrains.fr') }}/dashboard/', 'http', 'GET', 60, 'Edge Reverse Proxy Dashboard');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, url, type, method, interval, description) VALUES (2, 'Glances Monitoring', 1, 'https://glances.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, 'System & Container Resource Monitoring');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, url, type, method, interval, description) VALUES (3, 'Arcane PaaS Manager', 1, 'https://arcane.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, 'Docker Container Management Dashboard');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, url, type, method, interval, description) VALUES (4, 'Uptime Kuma Status', 1, 'https://status.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, 'Uptime & Service Health Monitor');"

        # Seed default public status page
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO status_page (id, slug, title, description, icon, theme, published) VALUES (1, 'default', '{{ traefik_domain | default('kamitbrains.fr') }} Infrastructure Status', 'Real-time status monitor for core services', '/icon.svg', 'auto', 1);"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO \`group\` (id, name, public, active, status_page_id, weight) VALUES (1, 'Core Infrastructure', 1, 1, 1, 1);"
        
        # Associate monitors with status page group
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor_group (monitor_id, group_id, weight) VALUES (1, 1, 1);"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor_group (monitor_id, group_id, weight) VALUES (2, 1, 2);"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor_group (monitor_id, group_id, weight) VALUES (3, 1, 3);"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor_group (monitor_id, group_id, weight) VALUES (4, 1, 4);"

        echo "Uptime Kuma monitors and public status page seeded successfully!"
    depends_on:
      - uptime-kuma
    restart: "no"
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M

volumes:
  uptime-kuma-data:
    name: uptime-kuma-data
    driver: local

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
