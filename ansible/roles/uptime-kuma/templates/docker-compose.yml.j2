# Uptime Kuma Status & Uptime Monitoring Stack
# Generated by Ansible — do not edit manually
# Monitors / notification / status page are seeded by the role (seed.sql via docker exec), no seeder container.

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/uptime-kuma.svg
  urls:
    - https://uptime.kuma.pet/
    - https://github.com/louislam/uptime-kuma

services:
  uptime-kuma:
    image: {{ uptime_kuma_image }}
    container_name: {{ uptime_kuma_container }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ uptime_kuma_port }}:3001"   # Traefik reaches it on the network; never expose past TinyAuth
    volumes:
      - {{ uptime_kuma_volume }}:/app/data
    environment:
      - TZ={{ uptime_kuma_timezone }}
      - UMASK=0022
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    security_opt:
      - no-new-privileges:true
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/uptime-kuma.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.uptime-kuma.rule=Host(`{{ uptime_kuma_hostname }}`) || Host(`{{ uptime_kuma_alias_hostname }}`)"
      - "traefik.http.routers.uptime-kuma.entrypoints=websecure"
      - "traefik.http.routers.uptime-kuma.tls.certresolver=letsencrypt"
      - "traefik.http.routers.uptime-kuma.middlewares=crowdsec-bouncer@file,tinyauth-auth@docker"
      - "traefik.http.routers.uptime-kuma.service=uptime-kuma"
{% if uptime_kuma_status_page_public | bool %}
      # Public status page: no TinyAuth on the page, its API and static assets (dashboard stays protected)
      - "traefik.http.routers.uptime-kuma-public.rule=(Host(`{{ uptime_kuma_hostname }}`) || Host(`{{ uptime_kuma_alias_hostname }}`)) && (PathPrefix(`/status/`) || PathPrefix(`/api/status-page/`) || PathPrefix(`/api/badge/`) || PathPrefix(`/assets/`) || PathPrefix(`/upload/`) || Path(`/api/entry-page`) || Path(`/icon.svg`) || Path(`/favicon.ico`) || Path(`/apple-touch-icon.png`) || Path(`/manifest.json`))"
      - "traefik.http.routers.uptime-kuma-public.priority=100"
      - "traefik.http.routers.uptime-kuma-public.entrypoints=websecure"
      - "traefik.http.routers.uptime-kuma-public.tls.certresolver=letsencrypt"
      - "traefik.http.routers.uptime-kuma-public.middlewares=crowdsec-bouncer@file"
      - "traefik.http.routers.uptime-kuma-public.service=uptime-kuma"
{% endif %}
      - "traefik.http.services.uptime-kuma.loadbalancer.server.port=3001"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3001/api/entry-page"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 384M
        reservations:
          cpus: "0.05"
          memory: 96M

volumes:
  {{ uptime_kuma_volume }}:
    name: {{ uptime_kuma_volume }}
    driver: local

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
