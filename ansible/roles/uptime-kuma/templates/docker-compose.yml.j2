# Uptime Kuma Status & Uptime Monitoring Stack
# Generated by Ansible — do not edit manually

services:
  uptime-kuma:
    image: {{ uptime_kuma_image }}
    container_name: uptime-kuma
    restart: unless-stopped
    ports:
      - "{{ uptime_kuma_port }}:3001"
    volumes:
      - uptime-kuma-data:/app/data
    environment:
      - TZ={{ uptime_kuma_timezone }}
      - UMASK=0022
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.uptime-kuma.rule=Host(`{{ uptime_kuma_hostname }}`)"
      - "traefik.http.routers.uptime-kuma.entrypoints=websecure"
      - "traefik.http.routers.uptime-kuma.tls.certresolver=letsencrypt"
      - "traefik.http.routers.uptime-kuma.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.uptime-kuma.loadbalancer.server.port=3001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 512M
        reservations:
          cpus: "0.10"
          memory: 128M

  uptime-kuma-db-seeder:
    image: alpine:latest
    container_name: uptime-kuma-db-seeder
    volumes:
      - uptime-kuma-data:/app/data
    entrypoint:
      - sh
      - -c
      - |
        if [ ! -f /app/data/db-config.json ]; then
          echo '{"dbType":"sqlite"}' > /app/data/db-config.json
        fi
        echo "Waiting for Uptime Kuma database..."
        until [ -f /app/data/kuma.db ]; do sleep 1; done
        apk add --no-cache -q sqlite
        
        # Seed core infrastructure monitors with user_id = 1 and Basic Auth credentials (auth_method = 'basic')
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, basic_auth_user, basic_auth_pass, auth_method, description) VALUES (1, 'Traefik Proxy', 1, 1, 'https://traefik.{{ traefik_domain | default('kamitbrains.fr') }}/dashboard/', 'http', 'GET', 60, '{{ uptime_kuma_traefik_auth_user }}', '{{ uptime_kuma_traefik_auth_pass }}', 'basic', 'Edge Reverse Proxy Dashboard');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, basic_auth_user, basic_auth_pass, auth_method, description) VALUES (2, 'Glances Monitoring', 1, 1, 'https://glances.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, '{{ uptime_kuma_glances_auth_user }}', '{{ uptime_kuma_glances_auth_pass }}', 'basic', 'System & Container Resource Monitoring');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, description) VALUES (3, 'Arcane PaaS Manager', 1, 1, 'https://arcane.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, 'Docker Container Management Dashboard');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, description) VALUES (4, 'Uptime Kuma Status', 1, 1, 'https://status.{{ traefik_domain | default('kamitbrains.fr') }}/dashboard', 'http', 'GET', 60, 'Uptime & Service Health Monitor');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, description) VALUES (5, 'Ntfy Push Notifications', 1, 1, 'https://ntfy.{{ traefik_domain | default('kamitbrains.fr') }}/v1/health', 'http', 'GET', 60, 'HTTP Pub-Sub Push Notification Service');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, description) VALUES (6, 'Passbolt Password Manager', 1, 1, 'https://passwords.{{ traefik_domain | default('kamitbrains.fr') }}/healthcheck/status.json', 'http', 'GET', 60, 'OpenPGP Team Password Manager');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, description) VALUES (7, 'ChangeDetection.io', 1, 1, 'https://changedetection.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, 'Web & API Surveillance Monitor');"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO monitor (id, name, active, user_id, url, type, method, interval, description) VALUES (8, 'IT-Tools Collection', 1, 1, 'https://tools.{{ traefik_domain | default('kamitbrains.fr') }}/', 'http', 'GET', 60, 'Web Developer Tools Collection');"

        # Update basic auth credentials on existing monitors
        sqlite3 /app/data/kuma.db "UPDATE monitor SET basic_auth_user = '{{ uptime_kuma_traefik_auth_user }}', basic_auth_pass = '{{ uptime_kuma_traefik_auth_pass }}', auth_method = 'basic', user_id = 1 WHERE id = 1;"
        sqlite3 /app/data/kuma.db "UPDATE monitor SET basic_auth_user = '{{ uptime_kuma_glances_auth_user }}', basic_auth_pass = '{{ uptime_kuma_glances_auth_pass }}', auth_method = 'basic', user_id = 1 WHERE id = 2;"
        sqlite3 /app/data/kuma.db "UPDATE monitor SET url = 'https://status.{{ traefik_domain | default('kamitbrains.fr') }}/dashboard' WHERE id = 4;"
        sqlite3 /app/data/kuma.db "UPDATE monitor SET user_id = 1 WHERE user_id IS NULL;"

        # Seed default public status page
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO status_page (id, slug, title, description, icon, theme, published) VALUES (1, 'default', '{{ traefik_domain | default('kamitbrains.fr') }} Infrastructure Status', 'Real-time status monitor for core services', '/icon.svg', 'auto', 1);"
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO \`group\` (id, name, public, active, status_page_id, weight) VALUES (1, 'Core Infrastructure', 1, 1, 1, 1);"
        
        # Associate monitors with status page group (idempotent check)
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 1, 1, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 1 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 2, 1, 2 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 2 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 3, 1, 3 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 3 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 4, 1, 4 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 4 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 5, 1, 5 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 5 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 6, 1, 6 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 6 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 7, 1, 7 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 7 AND group_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_group (monitor_id, group_id, weight) SELECT 8, 1, 8 WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = 8 AND group_id = 1);"

        # Seed Ntfy Push Notification Channel (id = 1, default = 1)
        sqlite3 /app/data/kuma.db "INSERT OR IGNORE INTO notification (id, name, active, user_id, is_default, config) VALUES (1, 'Ntfy Push Alerts', 1, 1, 1, '{\"type\":\"ntfy\",\"name\":\"Ntfy Push Alerts\",\"ntfyserverurl\":\"https://ntfy.{{ traefik_domain | default('kamitbrains.fr') }}\",\"ntfytopic\":\"alerts\",\"ntfyPriority\":4,\"ntfyAuthenticationMethod\":\"none\",\"is_default\":true}');"

        # Link all monitors to Ntfy Notification Channel
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 1, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 1 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 2, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 2 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 3, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 3 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 4, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 4 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 5, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 5 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 6, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 6 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 7, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 7 AND notification_id = 1);"
        sqlite3 /app/data/kuma.db "INSERT INTO monitor_notification (monitor_id, notification_id) SELECT 8, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = 8 AND notification_id = 1);"

        # Enable Trust Proxy (Proxy de confiance = Oui) and set Primary Base URL
        sqlite3 /app/data/kuma.db "INSERT OR REPLACE INTO setting (key, value, type) VALUES ('trustProxy', 'true', 'general');"
        sqlite3 /app/data/kuma.db "INSERT OR REPLACE INTO setting (key, value, type) VALUES ('primaryBaseURL', '\"https://status.{{ traefik_domain | default('kamitbrains.fr') }}\"', 'general');"

        echo "Uptime Kuma monitors, Basic Auth, public status page, trustProxy, and Ntfy notifications seeded successfully!"
    depends_on:
      - uptime-kuma
    restart: "no"
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M

volumes:
  uptime-kuma-data:
    name: uptime-kuma-data
    driver: local

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
