-- Uptime Kuma — monitors, ntfy notification and status page managed by Ansible
-- Generated by Ansible — do not edit manually
-- Idempotent: INSERT OR IGNORE then UPDATE on fixed ids; monitors created in the UI are left untouched.
PRAGMA busy_timeout = 10000;
PRAGMA foreign_keys = ON;
BEGIN;

INSERT OR IGNORE INTO notification (id, name, active, user_id, is_default, config) VALUES (1, 'Ntfy Push Alerts', 1, 1, 1, '{}');
UPDATE notification SET name = 'Ntfy Push Alerts', active = 1, user_id = 1, is_default = 1,
  config = '{{ {'type': 'ntfy', 'name': 'Ntfy Push Alerts', 'ntfyserverurl': uptime_kuma_ntfy_url, 'ntfytopic': uptime_kuma_ntfy_topic, 'ntfyPriority': 4, 'ntfyAuthenticationMethod': 'none', 'isDefault': true} | to_json | replace("'", "''") }}'
  WHERE id = 1;

INSERT OR IGNORE INTO status_page (id, slug, title, description, icon, theme, published) VALUES (1, '{{ uptime_kuma_status_page_slug }}', '', '', '/icon.svg', 'auto', 1);
UPDATE status_page SET slug = '{{ uptime_kuma_status_page_slug }}', title = '{{ uptime_kuma_status_page_title | replace("'", "''") }}',
  description = 'Real-time status monitor for core services', published = 1 WHERE id = 1;
INSERT OR IGNORE INTO `group` (id, name, public, active, status_page_id, weight) VALUES (1, 'Core Infrastructure', 1, 1, 1, 1);

{% for m in uptime_kuma_monitors %}
{% set url = m.url if m.url is defined else 'https://' ~ m.sub ~ '.' ~ uptime_kuma_domain ~ (m.path | default('/')) %}
INSERT OR IGNORE INTO monitor (id, name, user_id, type) VALUES ({{ m.id }}, '', 1, 'http');
UPDATE monitor SET
  name = '{{ m.name | replace("'", "''") }}', description = '{{ m.description | default('') | replace("'", "''") }}',
  active = 1, user_id = 1, type = 'http', method = 'GET', url = '{{ url }}', interval = {{ uptime_kuma_monitor_interval }},
  accepted_statuscodes_json = '{{ m.accepted | default(["200-299"]) | to_json }}',
{% if m.auth is defined %}
  auth_method = 'basic', basic_auth_user = '{{ m.auth.user | replace("'", "''") }}', basic_auth_pass = '{{ m.auth.pass | replace("'", "''") }}'
{% else %}
  auth_method = NULL, basic_auth_user = NULL, basic_auth_pass = NULL
{% endif %}
  WHERE id = {{ m.id }};
INSERT INTO monitor_notification (monitor_id, notification_id)
  SELECT {{ m.id }}, 1 WHERE NOT EXISTS (SELECT 1 FROM monitor_notification WHERE monitor_id = {{ m.id }} AND notification_id = 1);
{% if m.public | default(true) %}
INSERT INTO monitor_group (monitor_id, group_id, weight)
  SELECT {{ m.id }}, 1, {{ m.id }} WHERE NOT EXISTS (SELECT 1 FROM monitor_group WHERE monitor_id = {{ m.id }} AND group_id = 1);
{% else %}
DELETE FROM monitor_group WHERE monitor_id = {{ m.id }} AND group_id = 1;
{% endif %}

{% endfor %}
INSERT INTO setting (key, value, type) VALUES ('trustProxy', 'true', 'general') ON CONFLICT(key) DO UPDATE SET value = excluded.value;
INSERT INTO setting (key, value, type) VALUES ('primaryBaseURL', '"https://{{ uptime_kuma_hostname }}"', 'general') ON CONFLICT(key) DO UPDATE SET value = excluded.value;
INSERT INTO setting (key, value, type) VALUES ('entryPage', '"{{ ('statusPage-' ~ uptime_kuma_status_page_slug) if uptime_kuma_status_page_as_entry | bool else 'dashboard' }}"', 'general') ON CONFLICT(key) DO UPDATE SET value = excluded.value;

COMMIT;
