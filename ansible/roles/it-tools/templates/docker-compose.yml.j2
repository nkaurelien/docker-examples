# IT-Tools Web Developer Tools Collection
# Generated by Ansible — do not edit manually

services:
  it-tools:
    image: {{ it_tools_image }}
    container_name: it-tools
    restart: unless-stopped
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.it-tools.rule=Host(`{{ it_tools_hostname }}`)"
      - "traefik.http.routers.it-tools.entrypoints=websecure"
      - "traefik.http.routers.it-tools.tls.certresolver=letsencrypt"
      - "traefik.http.routers.it-tools.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.it-tools.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
        reservations:
          memory: 32M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
