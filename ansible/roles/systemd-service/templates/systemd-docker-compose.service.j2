# {{ systemd_service_description }}
# Generated by Ansible — do not edit manually on server
# Server: {{ inventory_hostname }} ({{ app_domain | default('local') }})

[Unit]
Description={{ systemd_service_description }}
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ systemd_compose_dir }}
ExecStart=/usr/bin/docker compose {{ systemd_compose_files }} -p {{ systemd_project_name }} up -d
ExecStop=/usr/bin/docker compose {{ systemd_compose_files }} -p {{ systemd_project_name }} down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
