# PairDrop P2P WebRTC File Transfer Stack
# Generated by Ansible — do not edit manually

services:
  pairdrop:
    image: {{ pairdrop_image }}
    container_name: pairdrop
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Paris
      - WS_FALLBACK=true
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pairdrop.rule=Host(`{{ pairdrop_hostname }}`)"
      - "traefik.http.routers.pairdrop.entrypoints=websecure"
      - "traefik.http.routers.pairdrop.tls.certresolver=letsencrypt"
      - "traefik.http.routers.pairdrop.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.pairdrop.loadbalancer.server.port=3000"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:3000/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 64M
        reservations:
          memory: 16M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
