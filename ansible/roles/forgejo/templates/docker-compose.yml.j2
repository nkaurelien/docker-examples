# Forgejo Self-Hosted Git Platform Stack
# Generated by Ansible — do not edit manually

services:
  forgejo:
    image: {{ forgejo_image }}
    container_name: forgejo
    restart: unless-stopped
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - FORGEJO__server__DOMAIN={{ forgejo_hostname }}
      - FORGEJO__server__HTTP_PORT=3000
      - FORGEJO__server__ROOT_URL=https://{{ forgejo_hostname }}/
      - FORGEJO__server__SSH_PORT={{ forgejo_ssh_port }}
      - FORGEJO__server__SSH_DOMAIN={{ forgejo_hostname }}
    ports:
      - "{{ forgejo_ssh_port }}:22"
    volumes:
      - ./data:/data
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.forgejo.rule=Host(`{{ forgejo_hostname }}`)"
      - "traefik.http.routers.forgejo.entrypoints=websecure"
      - "traefik.http.routers.forgejo.tls.certresolver=letsencrypt"
      - "traefik.http.routers.forgejo.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.forgejo.loadbalancer.server.port=3000"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:3000/ || exit 1"]
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.75"
          memory: 256M
        reservations:
          memory: 64M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
