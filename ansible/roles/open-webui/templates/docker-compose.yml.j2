# Open WebUI AI User Interface Stack
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/open-webui.svg
  urls:
    - https://openwebui.com/
    - https://github.com/open-webui/open-webui

services:
  open-webui:
    image: {{ open_webui_image }}
    container_name: open-webui
    restart: unless-stopped
    environment:
      - OLLAMA_BASE_URL={{ ollama_base_url }}
      - WEBUI_AUTH={{ webui_auth }}
    volumes:
      - ./data:/app/backend/data
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/open-webui.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.open-webui.rule=Host(`{{ open_webui_hostname }}`) || Host(`{{ open_webui_alias_hostname }}`)"
      - "traefik.http.routers.open-webui.entrypoints=websecure"
      - "traefik.http.routers.open-webui.tls.certresolver=letsencrypt"
      - "traefik.http.routers.open-webui.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.open-webui.loadbalancer.server.port=8080"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 1024M
        reservations:
          cpus: "0.10"
          memory: 128M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
