# Portabase — Open Source Database & Volume Backup Platform
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/postgresql.svg
  urls:
    - https://github.com/Portabase/portabase

services:
  portabase-app:
    image: {{ portabase_image }}
    container_name: portabase-app
    restart: unless-stopped
    depends_on:
      portabase-db:
        condition: service_healthy
    environment:
      - DATABASE_URL=postgresql://{{ portabase_db_user }}:{{ portabase_db_password }}@portabase-db:5432/{{ portabase_db_name }}
      - PROJECT_URL=https://{{ portabase_hostname }}
      - PROJECT_SECRET={{ portabase_project_secret }}
      - TZ=Europe/Paris
    volumes:
      - portabase-data:/data
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - portabase-internal
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/postgresql.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.portabase.rule=Host(`{{ portabase_hostname }}`) || Host(`{{ portabase_alias_hostname }}`)"
      - "traefik.http.routers.portabase.entrypoints=websecure"
      - "traefik.http.routers.portabase.tls.certresolver=letsencrypt"
      - "traefik.http.routers.portabase.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.portabase.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:80/api/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M
        reservations:
          memory: 64M

  portabase-db:
    image: postgres:17-alpine
    container_name: portabase-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ portabase_db_name }}
      - POSTGRES_USER={{ portabase_db_user }}
      - POSTGRES_PASSWORD={{ portabase_db_password }}
    volumes:
      - portabase-db-data:/var/lib/postgresql/data
    networks:
      - portabase-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ portabase_db_user }} -d {{ portabase_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M
        reservations:
          memory: 64M

volumes:
  portabase-data:
  portabase-db-data:

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
  portabase-internal:
    driver: bridge
