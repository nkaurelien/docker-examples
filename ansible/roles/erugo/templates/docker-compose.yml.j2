# Erugo File Transfer Stack (WeTransfer alternative)
# Generated by Ansible — do not edit manually

services:
  erugo:
    image: {{ erugo_image }}
    container_name: erugo
    restart: unless-stopped
    volumes:
      - ./storage:/var/www/html/storage
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.erugo.rule=Host(`{{ erugo_hostname }}`)"
      - "traefik.http.routers.erugo.entrypoints=websecure"
      - "traefik.http.routers.erugo.tls.certresolver=letsencrypt"
      - "traefik.http.routers.erugo.middlewares=crowdsec-bouncer@file,tinyauth-auth@docker"
      - "traefik.http.services.erugo.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:80/ || exit 1"]
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          memory: 64M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
