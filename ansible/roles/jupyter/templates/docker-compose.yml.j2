# JupyterLab Interactive Data Science & AI Notebook Stack
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/jupyter.svg
  urls:
    - https://jupyter.org/
    - https://github.com/jupyter/docker-stacks

services:
  jupyter:
    image: {{ jupyter_image }}
    container_name: jupyter
    restart: unless-stopped
    command: start-notebook.sh --IdentityProvider.token='{{ jupyter_token }}' --NotebookApp.token='{{ jupyter_token }}'
    environment:
      - DOCKER_STACKS_JUPYTER_CMD=lab
      - JUPYTER_ENABLE_LAB=yes
      - JUPYTER_TOKEN={{ jupyter_token }}
      - RESTARTABLE=yes
    volumes:
      - ./data:/home/jovyan/work
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/jupyter.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.jupyter.rule=Host(`{{ jupyter_hostname }}`) || Host(`{{ jupyter_alias_hostname }}`)"
      - "traefik.http.routers.jupyter.entrypoints=websecure"
      - "traefik.http.routers.jupyter.tls.certresolver=letsencrypt"
      - "traefik.http.routers.jupyter.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.jupyter.loadbalancer.server.port=8888"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8888/lab || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "2.00"
          memory: 2048M
        reservations:
          cpus: "0.25"
          memory: 256M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
