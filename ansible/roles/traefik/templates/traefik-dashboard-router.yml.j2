# Traefik Dashboard Router Configuration
# Generated by Ansible — do not edit manually

http:
  routers:
    dashboard-redirect:
      rule: "Host(`{{ traefik_dashboard_host }}`) && Path(`/dashboard`)"
      service: api@internal
      entryPoints:
        - websecure
      middlewares:
        - dashboard-redirect@file
{% if traefik_enable_letsencrypt %}
      tls:
        certResolver: letsencrypt
{% endif %}

    dashboard:
      rule: "Host(`{{ traefik_dashboard_host }}`) && (PathPrefix(`/api`) || PathPrefix(`/dashboard/`))"
      service: api@internal
      entryPoints:
        - websecure
      middlewares:
        - dashboard-auth@file
{% if traefik_enable_letsencrypt %}
      tls:
        certResolver: letsencrypt
{% endif %}

  middlewares:
    dashboard-redirect:
      redirectRegex:
        regex: "^https://([^/]+)/dashboard$"
        replacement: "https://${1}/dashboard/"
        permanent: true
