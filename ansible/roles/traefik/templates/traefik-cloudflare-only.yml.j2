# {{ ansible_managed }}
# Plages d'IP de Cloudflare (https://www.cloudflare.com/ips-v4 et ips-v6), récupérées au déploiement.
# N'accepte que le trafic passé par Cloudflare : à placer en tête des routeurs derrière Cloudflare Access.
http:
  middlewares:
    cloudflare-only:
      ipAllowList:
        sourceRange:
{% for r in traefik_cloudflare_ranges %}
          - "{{ r }}"
{% endfor %}
