# Databasement — Self-Hosted Database Backup Manager & Web UI
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/postgresql.svg
  urls:
    - https://github.com/David-Crty/databasement

services:
  databasement:
    image: {{ databasement_image }}
    container_name: databasement
    hostname: databasement
    restart: unless-stopped
    environment:
      - DB_CONNECTION=sqlite
      - DB_DATABASE=/data/database.sqlite
      - ENABLE_QUEUE_WORKER=true
      - ENABLE_SCHEDULER=true
      - APP_PORT={{ databasement_port }}
      - APP_TIMEZONE=Europe/Paris
      - TZ=Europe/Paris
    volumes:
      - databasement-data:/data
      - /var/lib/docker/volumes:/userdata/volumes:ro
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - default
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/postgresql.svg"
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_public_network | default('traefik-public') }}"
      - "traefik.http.routers.databasement.rule=Host(`{{ databasement_hostname }}`) || Host(`{{ databasement_alias_hostname }}`)"
      - "traefik.http.routers.databasement.entrypoints=websecure"
      - "traefik.http.routers.databasement.tls.certresolver=letsencrypt"
      - "traefik.http.routers.databasement.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.databasement.loadbalancer.server.port={{ databasement_port }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ databasement_port }}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512M
        reservations:
          memory: 128M

volumes:
  databasement-data:

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
