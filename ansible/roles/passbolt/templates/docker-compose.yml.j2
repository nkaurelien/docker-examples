# Passbolt Team Password Manager Stack (PostgreSQL Edition)
# Generated by Ansible — do not edit manually

services:
  passbolt-db:
    image: {{ passbolt_postgres_image }}
    container_name: passbolt-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ passbolt_db_name }}
      - POSTGRES_USER={{ passbolt_db_user }}
      - POSTGRES_PASSWORD={{ passbolt_db_password }}
    volumes:
      - passbolt-db-data:/var/lib/postgresql/data
    networks:
      - passbolt-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ passbolt_db_user }} -d {{ passbolt_db_name }} || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          memory: 64M

  passbolt:
    image: {{ passbolt_image }}
    container_name: passbolt
    restart: unless-stopped
    depends_on:
      passbolt-db:
        condition: service_healthy
    environment:
      - APP_FULL_BASE_URL=https://{{ passbolt_hostname }}
      - DATASOURCES_DEFAULT_DRIVER=Cake\Database\Driver\Postgres
      - DATASOURCES_DEFAULT_HOST=passbolt-db
      - DATASOURCES_DEFAULT_PORT=5432
      - DATASOURCES_DEFAULT_USERNAME={{ passbolt_db_user }}
      - DATASOURCES_DEFAULT_PASSWORD={{ passbolt_db_password }}
      - DATASOURCES_DEFAULT_DATABASE={{ passbolt_db_name }}
      - DATASOURCES_DEFAULT_ENCODING=utf8
    volumes:
      - passbolt-gpg-keys:/etc/passbolt/gpg
      - passbolt-jwt-keys:/etc/passbolt/jwt
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - passbolt-internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.passbolt.rule=Host(`{{ passbolt_hostname }}`)"
      - "traefik.http.routers.passbolt.entrypoints=websecure"
      - "traefik.http.routers.passbolt.tls.certresolver=letsencrypt"
      - "traefik.http.routers.passbolt.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.passbolt.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1/healthcheck/status.json || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.75"
          memory: 256M
        reservations:
          memory: 64M


  passbolt-init:
    image: {{ passbolt_image }}
    container_name: passbolt-init
    restart: "no"
    depends_on:
      passbolt:
        condition: service_healthy
    environment:
      - APP_FULL_BASE_URL=https://{{ passbolt_hostname }}
      - DATASOURCES_DEFAULT_DRIVER=Cake\Database\Driver\Postgres
      - DATASOURCES_DEFAULT_HOST=passbolt-db
      - DATASOURCES_DEFAULT_PORT=5432
      - DATASOURCES_DEFAULT_USERNAME={{ passbolt_db_user }}
      - DATASOURCES_DEFAULT_PASSWORD={{ passbolt_db_password }}
      - DATASOURCES_DEFAULT_DATABASE={{ passbolt_db_name }}
      - DATASOURCES_DEFAULT_ENCODING=utf8
    volumes:
      - passbolt-gpg-keys:/etc/passbolt/gpg
      - passbolt-jwt-keys:/etc/passbolt/jwt
    networks:
      - passbolt-internal
    user: www-data
    entrypoint: >
      /bin/sh -c "
      echo 'Checking Passbolt admin user initialization status...';
      /usr/share/php/passbolt/bin/cake passbolt users_index | grep -q '{{ passbolt_admin_email }}' || \
      /usr/share/php/passbolt/bin/cake passbolt register_user -u {{ passbolt_admin_email }} -f Admin -l User -r admin;
      "

volumes:
  passbolt-db-data:
    name: passbolt-db-data
    driver: local
  passbolt-gpg-keys:
    name: passbolt-gpg-keys
    driver: local
  passbolt-jwt-keys:
    name: passbolt-jwt-keys
    driver: local

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
  passbolt-internal:
    internal: true
