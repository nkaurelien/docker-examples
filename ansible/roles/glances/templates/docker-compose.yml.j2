# Glances Real-time Host & Container Monitoring
# Generated by Ansible — do not edit manually

services:
  glances-socket-proxy:
    image: tecnativa/docker-socket-proxy:latest
    container_name: glances-socket-proxy
    restart: unless-stopped
    networks:
      - glances-internal
    environment:
      - CONTAINERS=1
      - EVENTS=1
      - INFO=1
      - NETWORKS=1
      - VERSION=1
      - POST=0
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"

  glances:
    image: {{ glances_image }}
    container_name: glances
    command: ["glances", "-w"]
    depends_on:
      - glances-socket-proxy
    environment:
      - GLANCES_OPT=-w
      - TZ={{ glances_timezone }}
      - DOCKER_HOST=tcp://glances-socket-proxy:2375
    pid: host
    privileged: true
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - glances-internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.glances.rule=Host(`{{ glances_hostname }}`)"
      - "traefik.http.routers.glances.entrypoints=websecure"
      - "traefik.http.routers.glances.tls.certresolver=letsencrypt"
      - "traefik.http.routers.glances.middlewares=glances-auth@file"
      - "traefik.http.services.glances.loadbalancer.server.port=61208"
    volumes:
      - /:/rootfs:ro
      - /etc/os-release:/etc/os-release:ro
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '{{ glances_cpu_limit }}'
          memory: {{ glances_memory_limit }}
        reservations:
          cpus: '{{ glances_cpu_reservation }}'
          memory: {{ glances_memory_reservation }}

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
  glances-internal:
    internal: true
