# Glances Real-time Host & Container Monitoring
# Generated by Ansible — do not edit manually

services:
  glances:
    image: {{ glances_image }}
    container_name: glances
    command: ["glances", "-w"]
    environment:
      GLANCES_OPT: "-w"
      TZ: {{ glances_timezone }}
      DOCKER_HOST: "tcp://127.0.0.1:2375"
    pid: host
    privileged: true
    network_mode: host
    volumes:
      - /:/rootfs:ro
      - /etc/os-release:/etc/os-release:ro
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '{{ glances_cpu_limit }}'
          memory: {{ glances_memory_limit }}
        reservations:
          cpus: '{{ glances_cpu_reservation }}'
          memory: {{ glances_memory_reservation }}
