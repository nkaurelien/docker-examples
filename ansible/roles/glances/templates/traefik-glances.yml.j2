# Traefik Dynamic Configuration for Glances
# Generated by Ansible — do not edit manually

http:
  routers:
    glances:
      rule: "Host(`{{ glances_hostname }}`)"
      entryPoints:
        - web
      service: glances-service

  services:
    glances-service:
      loadBalancer:
        servers:
          - url: "http://172.17.0.1:{{ glances_port }}"
