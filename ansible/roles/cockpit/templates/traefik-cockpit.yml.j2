# Traefik Dynamic Configuration for Cockpit
# Generated by Ansible — do not edit manually

http:
  routers:
    cockpit:
      rule: "Host(`{{ cockpit_hostname }}`)"
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      service: cockpit-service

  services:
    cockpit-service:
      loadBalancer:
        servers:
          - url: "http://172.17.0.1:{{ cockpit_port }}"
