# Paperless-ngx Open Source Document Management Stack
# Generated by Ansible — do not edit manually

x-arcane:
  icon: https://raw.githubusercontent.com/selfhst/icons/main/svg/paperless-ngx.svg
  urls:
    - https://docs.paperless-ngx.com/
    - https://github.com/paperless-ngx/paperless-ngx

services:
  paperless:
    image: {{ paperless_image }}
    container_name: paperless
    restart: unless-stopped
    depends_on:
      paperless-db:
        condition: service_healthy
      paperless-redis:
        condition: service_healthy
    environment:
      - PAPERLESS_REDIS=redis://paperless-redis:6379
      - PAPERLESS_DBHOST=paperless-db
      - PAPERLESS_DBNAME={{ paperless_db_name }}
      - PAPERLESS_DBUSER={{ paperless_db_user }}
      - PAPERLESS_DBPASS={{ paperless_db_password }}
      - PAPERLESS_SECRET_KEY={{ paperless_secret_key }}
      - PAPERLESS_URL=https://{{ paperless_hostname }}
      - PAPERLESS_TIME_ZONE=Europe/Paris
      - PAPERLESS_OCR_LANGUAGE=fra+eng
      - PAPERLESS_ADMIN_USER={{ paperless_admin_user }}
      - PAPERLESS_ADMIN_PASSWORD={{ paperless_admin_password }}
      - USERMAP_UID=1000
      - USERMAP_GID=1000
    volumes:
      - paperless-data:/usr/src/paperless/data
      - paperless-media:/usr/src/paperless/media
      - ./export:/usr/src/paperless/export
      - ./consume:/usr/src/paperless/consume
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - paperless-internal
    labels:
      - "com.getarcaneapp.arcane.icon=https://raw.githubusercontent.com/selfhst/icons/main/svg/paperless-ngx.svg"
      - "traefik.enable=true"
      - "traefik.http.routers.paperless.rule=Host(`{{ paperless_hostname }}`) || Host(`{{ paperless_alias_hostname }}`)"
      - "traefik.http.routers.paperless.entrypoints=websecure"
      - "traefik.http.routers.paperless.tls.certresolver=letsencrypt"
      - "traefik.http.routers.paperless.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.paperless.loadbalancer.server.port={{ paperless_container_port }}"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ paperless_container_port }}/"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "2.00"
          memory: 1024M
        reservations:
          cpus: "0.20"
          memory: 256M

  paperless-db:
    image: postgres:16-alpine
    container_name: paperless-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ paperless_db_name }}
      - POSTGRES_USER={{ paperless_db_user }}
      - POSTGRES_PASSWORD={{ paperless_db_password }}
    volumes:
      - paperless-db-data:/var/lib/postgresql/data
    networks:
      - paperless-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ paperless_db_user }} -d {{ paperless_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M
        reservations:
          memory: 128M

  paperless-redis:
    image: valkey/valkey:8-alpine
    container_name: paperless-redis
    restart: unless-stopped
    volumes:
      - paperless-redis-data:/data
    networks:
      - paperless-internal
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          memory: 32M

volumes:
  paperless-data:
  paperless-media:
  paperless-db-data:
  paperless-redis-data:

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
  paperless-internal:
    driver: bridge
