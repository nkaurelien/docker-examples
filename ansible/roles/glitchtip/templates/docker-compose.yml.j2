# GlitchTip Open-Source Error Tracking & APM Stack
# Generated by Ansible — do not edit manually

services:
  glitchtip-db:
    image: {{ glitchtip_postgres_image }}
    container_name: glitchtip-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ glitchtip_db_name }}
      - POSTGRES_USER={{ glitchtip_db_user }}
      - POSTGRES_PASSWORD={{ glitchtip_db_password }}
    volumes:
      - glitchtip-db-data:/var/lib/postgresql/data
    networks:
      - glitchtip-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ glitchtip_db_user }} -d {{ glitchtip_db_name }} || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          memory: 64M

  glitchtip-valkey:
    image: {{ glitchtip_valkey_image }}
    container_name: glitchtip-valkey
    restart: unless-stopped
    networks:
      - glitchtip-internal
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep PONG || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
        reservations:
          memory: 32M

  glitchtip:
    image: {{ glitchtip_image }}
    container_name: glitchtip
    restart: unless-stopped
    depends_on:
      glitchtip-db:
        condition: service_healthy
      glitchtip-valkey:
        condition: service_healthy
    environment:
      - DATABASE_URL=postgres://{{ glitchtip_db_user }}:{{ glitchtip_db_password }}@glitchtip-db:5432/{{ glitchtip_db_name }}
      - VALKEY_URL=redis://glitchtip-valkey:6379
      - SECRET_KEY={{ glitchtip_secret_key }}
      - GLITCHTIP_DOMAIN=https://{{ glitchtip_hostname }}
      - DEFAULT_FROM_EMAIL={{ glitchtip_admin_email }}
      - EMAIL_URL=consolemail://
      - ENABLE_ADMIN=True
      - ENABLE_OPENAPI=False
      - SERVER_ROLE=all_in_one
      - PORT=8000
    volumes:
      - glitchtip-uploads:/code/uploads
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
      - glitchtip-internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.glitchtip.rule=Host(`{{ glitchtip_hostname }}`)"
      - "traefik.http.routers.glitchtip.entrypoints=websecure"
      - "traefik.http.routers.glitchtip.tls.certresolver=letsencrypt"
      - "traefik.http.routers.glitchtip.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.glitchtip.loadbalancer.server.port=8000"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/_health/')"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M
        reservations:
          memory: 128M

  glitchtip-init:
    image: {{ glitchtip_image }}
    container_name: glitchtip-init
    restart: "no"
    depends_on:
      glitchtip:
        condition: service_healthy
    environment:
      - DATABASE_URL=postgres://{{ glitchtip_db_user }}:{{ glitchtip_db_password }}@glitchtip-db:5432/{{ glitchtip_db_name }}
      - VALKEY_URL=redis://glitchtip-valkey:6379
      - SECRET_KEY={{ glitchtip_secret_key }}
      - DJANGO_SUPERUSER_EMAIL={{ glitchtip_admin_email }}
      - DJANGO_SUPERUSER_PASSWORD={{ glitchtip_admin_password }}
    networks:
      - glitchtip-internal
    entrypoint: >
      /bin/sh -c "
      echo 'Checking GlitchTip admin initialization...';
      python manage.py createsuperuser --noinput --email {{ glitchtip_admin_email }} || echo 'Superuser already exists.';
      "

volumes:
  glitchtip-db-data:
    name: glitchtip-db-data
    driver: local
  glitchtip-uploads:
    name: glitchtip-uploads
    driver: local

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
  glitchtip-internal:
    internal: true
