# Jenkins Continuous Integration Server Stack
# Generated by Ansible — do not edit manually

services:
  jenkins:
    image: {{ jenkins_image }}
    container_name: jenkins
    restart: unless-stopped
    ports:
      - "8082:8080"
      - "50000:50000"
    environment:
      - JAVA_OPTS={{ jenkins_java_opts }}
    volumes:
      - ./data:/var/jenkins_home
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jenkins.rule=Host(`{{ jenkins_hostname }}`)"
      - "traefik.http.routers.jenkins.entrypoints=websecure"
      - "traefik.http.routers.jenkins.tls.certresolver=letsencrypt"
      - "traefik.http.routers.jenkins.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.jenkins.loadbalancer.server.port=8080"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:8080/login || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "1.50"
          memory: 2048M
        reservations:
          cpus: "0.20"
          memory: 512M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
