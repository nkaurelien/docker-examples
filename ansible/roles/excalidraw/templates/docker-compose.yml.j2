# Excalidraw Virtual Whiteboard Stack
# Generated by Ansible — do not edit manually

services:
  excalidraw:
    image: {{ excalidraw_image }}
    container_name: excalidraw
    restart: unless-stopped
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.excalidraw.rule=Host(`{{ excalidraw_hostname }}`)"
      - "traefik.http.routers.excalidraw.entrypoints=websecure"
      - "traefik.http.routers.excalidraw.tls.certresolver=letsencrypt"
      - "traefik.http.routers.excalidraw.middlewares=crowdsec-bouncer@file,tinyauth-auth@docker"
      - "traefik.http.services.excalidraw.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "2"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 64M
        reservations:
          memory: 16M

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
