# ChangeDetection.io Web Surveillance Stack
# Generated by Ansible — do not edit manually

services:
  changedetection:
    image: {{ changedetection_image }}
    container_name: changedetection
    restart: unless-stopped
    environment:
      - BASE_URL=https://{{ changedetection_hostname }}
      - HIDE_REFERER=true
    volumes:
      - changedetection-data:/datastore
    networks:
      - {{ traefik_public_network | default('traefik-public') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.changedetection.rule=Host(`{{ changedetection_hostname }}`)"
      - "traefik.http.routers.changedetection.entrypoints=websecure"
      - "traefik.http.routers.changedetection.tls.certresolver=letsencrypt"
      - "traefik.http.routers.changedetection.middlewares=crowdsec-bouncer@file"
      - "traefik.http.services.changedetection.loadbalancer.server.port=5000"
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/')\" || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          memory: 64M

volumes:
  changedetection-data:
    name: changedetection-data
    driver: local

networks:
  {{ traefik_public_network | default('traefik-public') }}:
    external: true
