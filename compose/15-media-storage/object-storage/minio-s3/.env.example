# ============================================
# Minio S3 Environment Variables
# ============================================
# Copy this file: cp .env.example .env
# Then configure the values below.

DOMAIN=apps.local

# --- Credentials ---------------------------------------------------------
MINIO_ROOT_USER=minioadmin
# Obligatoire (compose.encrypted.yml echoue si vide) :
#   head -c 24 /dev/urandom | base64 | tr -d '\n=+/'
MINIO_ROOT_PASSWORD=

# --- Chiffrement au repos (compose.encrypted.yml uniquement) --------------
# Cle maitre : 32 octets bruts encodes en base64 (44 caracteres).
#   head -c 32 /dev/urandom | base64
# ⚠ La perdre rend les objets ET la config IAM illisibles, definitivement.
# ⚠ La changer sur une instance existante a le meme effet : MinIO ne
#   re-chiffre pas retroactivement. Aucune rotation en place possible avec
#   le KMS interne — le multi-cles impose KES.
MINIO_KMS_KEY=
MINIO_KMS_KEY_NAME=demo-key
# `on` chiffre aussi les uploads qui n'envoient aucun header SSE.
MINIO_KMS_AUTO_ENCRYPTION=on
MINIO_DEFAULT_BUCKET=demo-bucket

# --- Divers ---------------------------------------------------------------
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
