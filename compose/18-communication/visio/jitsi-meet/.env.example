# =============================================================================
# Jitsi Meet — copier en .env (`make setup` génère les secrets)
# =============================================================================
COMPOSE_PROJECT_NAME=jitsi-meet
JITSI_IMAGE_VERSION=stable-11031
PUBLIC_URL=https://meet.example.com
TZ=Europe/Paris

# Web : derrière le reverse proxy uniquement.
JITSI_HTTP_BIND=127.0.0.1
JITSI_HTTP_PORT=8000
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

# Médias : UDP, IP publique annoncée aux navigateurs (plusieurs : séparées par des virgules).
JVB_PORT=10000
JVB_ADVERTISE_IPS=203.0.113.10

# Comptes XMPP internes (make setup).
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

# Accès réservé aux porteurs d'un jeton signé par votre backend : pas d'invités anonymes.
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
JWT_APP_ID=my-app
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=my-app
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_ALLOW_EMPTY=0

# Pas d'enregistrement ni de transcription par défaut (données personnelles).
ENABLE_RECORDING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0

# --- Événements de salle (event_sync) → votre backend (make event-sync) ----------------------
# Vide = désactivé. Le backend reçoit POST <url>/events/{room,occupant}/{created,destroyed,joined,left}.
EVENT_SYNC_URL=
EVENT_SYNC_TOKEN=

# --- Relais TURN (laisser vide si aucun) -----------------------------------------------------
# A) coturn local (profil `turn`) : secret partagé, Prosody délivre des identifiants temporaires.
#    TURN_HOST=turn.example.com  TURN_PORT=3478  TURN_TRANSPORT=udp,tcp  TURN_CREDENTIALS=<secret>
#    TURNS_HOST=turn.example.com TURNS_PORT=5349 (TLS)
# B) service géré (ex. Cloudflare) : identifiant fixe, à renouveler avant expiration.
#    TURNS_HOST=turn.cloudflare.com TURNS_PORT=443 TURN_USERNAME=<user> TURN_PASSWORD=<credential>
TURN_HOST=
TURN_PORT=3478
TURN_TRANSPORT=udp,tcp
TURNS_HOST=
TURNS_PORT=5349
TURN_CREDENTIALS=
TURN_REALM=meet.example.com
TURN_USERNAME=
TURN_PASSWORD=
