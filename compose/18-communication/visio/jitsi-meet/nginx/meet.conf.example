# Vhost nginx devant Jitsi Web (127.0.0.1:8000). Les médias passent en UDP 10000, hors nginx.
server {
    listen 443 ssl http2;
    server_name meet.example.com;

    ssl_certificate     /etc/ssl/meet.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/meet.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # La visio n'est intégrable (iframe) que depuis vos applications.
    add_header Content-Security-Policy "frame-ancestors 'self' https://app.example.com" always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location = /xmpp-websocket {
        proxy_pass http://127.0.0.1:8000/xmpp-websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        tcp_nodelay on;
    }

    location ~ ^/colibri-ws/([a-zA-Z0-9-\_]+)/(.*) {
        proxy_pass http://127.0.0.1:8000/colibri-ws/$1/$2$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        tcp_nodelay on;
    }
}

server {
    listen 80;
    server_name meet.example.com;
    return 301 https://$host$request_uri;
}
