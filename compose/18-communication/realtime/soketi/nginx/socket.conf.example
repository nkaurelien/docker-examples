# Vhost de production : n'expose QUE le WebSocket (/app/). L'API de publication (/apps/…)
# reste interne, le backend la joint par le réseau Docker (http://soketi:6001).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name socket.example.com;

    ssl_certificate     /etc/ssl/example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.com/privkey.pem;

    location /app/ {
        proxy_pass http://127.0.0.1:6001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;   # connexions longues
        proxy_send_timeout 3600s;
    }

    location / {
        return 404;                 # /apps/… (publication), /metrics, /ready : jamais depuis Internet
    }
}
