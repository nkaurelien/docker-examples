# Soketi — copiez en .env (make setup génère KEY et SECRET).
# Id NUMÉRIQUE obligatoire : le SDK Python `pusher` refuse un id textuel (ValueError: Invalid app id).
SOKETI_APP_ID=1001
# openssl rand -hex 16
SOKETI_APP_KEY=change-me
# openssl rand -hex 32
SOKETI_APP_SECRET=change-me

# Préfixe des canaux qui déclenchent les webhooks connecté/déconnecté (production : private-user.)
WEBHOOK_CHANNEL_PREFIX=demo-user.

# Ports publiés sur 127.0.0.1
SOKETI_PORT=6001
SOKETI_METRICS_PORT=9601
DEMO_PORT=8088
SOKETI_DEBUG=0
