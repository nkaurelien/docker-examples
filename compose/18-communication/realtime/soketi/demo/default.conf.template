server {
    listen 80;
    root /usr/share/nginx/html;

    # Clé publique de l'application (jamais le secret) injectée par envsubst au démarrage.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.SOKETI = { key: "${SOKETI_APP_KEY}", port: ${SOKETI_PUBLIC_PORT} };';
    }

    location / {
        try_files $uri /index.html;
    }
}
