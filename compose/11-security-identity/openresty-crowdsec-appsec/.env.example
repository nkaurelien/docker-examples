# OpenResty + CrowdSec AppSec - configuration

# Clé partagée entre la LAPI CrowdSec et le bouncer OpenResty.
# Générer une valeur aléatoire : openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=change-me-generate-with-openssl-rand-hex-32

# Port HTTP publié sur l'hôte
HTTP_PORT=80

# Fuseau horaire de CrowdSec
TZ=Europe/Paris
